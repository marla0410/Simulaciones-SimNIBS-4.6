    r"C:\SimNIBS\TMS\simulaciones\pilot_TMS_1-0001_MagVenture_Cool-D-B80_scalar.msh"
)
# Se extrae únicamente la sustancia gris
gray_matter = head_mesh.crop_mesh(simnibs.ElementTags.GM)

# Insertar coordenadas MNI del área a analizar
mni_coords = [X, Y, Z]

# Se convierten las coordenadas MNI al espacio del sujeto
