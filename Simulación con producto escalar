subject_coords = simnibs.mni2subject_coords(
    mni_coords,
    r"C:\SimNIBS\scans\m2m_pilot"
)
# Definir una ROI esférica de x mm
radius = x.0  # m

# Centros de los elementos de la sustancia gris
elm_centers = gray_matter.elements_baricenters()[:]

# Distancia de cada elemento al centro de la ROI
distances = np.linalg.norm(
    elm_centers - subject_coords,
    axis=1
)
# Elementos dentro de la ROI
roi = distances < radius

# Volúmenes de cada elemento
elm_volumes = gray_matter.elements_volumes_and_areas()[:]

# Aquí se genera un esquema visual de la ROI

gray_matter.add_element_field(
    roi.astype(int),
    "ROI"
)
gray_matter.view(
    visible_fields="ROI"
).show()

# Parámetros para simular la estimulación
# % MSO de salida del estimulador
mso_percent = 50.0 

# Tasa máxima de cambio de corriente (A/us al 100% MSO)
# Consultar para cada equipo de acuerdo a Drakiti et al. (2022)
max_di_dt = x.0 

# Producto escalar para calcular la tasa de cambio real
di_dt_real = max_di_dt * (mso_percent / 100.0)

# Obtener y escalar la magnitud del campo eléctrico
field_name = "magnE"

# Extracción de la matriz normalizada y multiplicación escalar
field = gray_matter.field[field_name][:] * di_dt_real

# Extraer los valores del campo correspondientes a la ROI
roi_field = field[roi]
roi_volumes = elm_volumes[roi]

# Estadísticas del campo eléctrico
# Campo eléctrico medio ponderado por volumen
mean_field = np.average(
    roi_field,
    weights=roi_volumes
)

# Campo eléctrico máximo
max_field = np.max(roi_field)

# Campo eléctrico mínimo
min_field = np.min(roi_field)

# Desviación estándar
std_field = np.std(roi_field)

# Filtrar el percentil 99.5
field_99_5 = np.percentile(
    roi_field,
    99.5
)

# Fijar el umbral del campo E
threshold = 80.0  # V/m

# Identificar elementos y volumen que alcanzan E >= 80 V/m
suprathreshold = roi_field >= threshold
volume_above_threshold = np.sum(
    roi_volumes[suprathreshold]
)
# Calcular el volumen de la ROI

total_roi_volume = np.sum(
    roi_volumes
)

# % del volumen de la ROI con E >= 80 V/m

percentage_volume = (
    volume_above_threshold /
    total_roi_volume
) * 100

############################################################
# Porcentaje de elementos que superan el umbral
############################################################

